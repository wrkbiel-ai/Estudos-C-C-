{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configurar meu_bot",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/meu-bot-ia",
                "-B",
                "${workspaceFolder}/meu-bot-ia/build"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: compilar meu_bot",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/meu-bot-ia/build",
                "--config",
                "Release",
                "--target",
                "meu_bot"
            ],
            "dependsOn": "CMake: configurar meu_bot",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
